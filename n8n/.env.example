# Copy to n8n/.env (git-ignored) and fill in. Generate secrets with: openssl rand -hex 32

# Encrypts credentials stored in n8n's database. Keep it stable across restarts.
N8N_ENCRYPTION_KEY=

# Convex -> n8n: Convex signs loan events with this; the webhook verifies them.
# Must equal LENDLOOP_TO_N8N_SECRET in the Convex deployment's environment.
LENDLOOP_TO_N8N_SECRET=

# n8n -> Convex: n8n signs calls to the Convex HTTP endpoints with this.
# Must equal N8N_TO_LENDLOOP_SECRET in the Convex deployment's environment.
N8N_TO_LENDLOOP_SECRET=

# Convex HTTP actions URL (ends in .convex.site for cloud deployments).
# For a local Convex backend use http://host.docker.internal:3211
CONVEX_SITE_URL=

# Optional
GENERIC_TIMEZONE=UTC
# N8N_PUBLIC_URL=https://n8n.example.com/
# SIMULATE_NOTIFY_FAILURE=true   # make the mock channels fail, to see retries + error workflow
